<%- include('includes/head.ejs') %>


<main class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
    <div class="max-w-md w-full bg-white p-8 rounded-lg shadow-md border border-gray-100">
        <h2 class="text-2xl font-bold text-center text-[#703d56] mb-8">Iniciar Sesión</h2>
        
        <form action="/users/login" method="POST" class="space-y-6">
            <div>
                <label for="username" class="block text-sm font-semibold text-gray-700">Usuario</label>
                <input type="text" id="username" name="username" required 
                    class="w-full p-2.5 border border-gray-300 rounded-md mt-1 focus:ring-2 focus:ring-[#be12b6] outline-none transition shadow-sm">
            </div>

            <div>
                <label for="password" class="block text-sm font-semibold text-gray-700">Contraseña</label>
                <input type="password" id="password" name="password" required 
                    class="w-full p-2.5 border border-gray-300 rounded-md mt-1 focus:ring-2 focus:ring-[#be12b6] outline-none transition shadow-sm">
            </div>

            <button type="submit" 
                class="w-full bg-[#703d56] text-white py-3 rounded-md font-bold hover:bg-[#be12b6] transition duration-300 shadow-md transform hover:-translate-y-0.5">
                Entrar
            </button>
        </form>
    </div>
</main>

<%- include('includes/footer.ejs') %>

