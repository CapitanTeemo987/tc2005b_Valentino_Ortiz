<%- include('includes/head.ejs') %>
   
    <main>
        <% if (username != '') { %>
            <h1>Bienvenido, <%= username %></h1>
            <p>Has iniciado sesión correctamente</p>
            <p>Usa /lab/completo - /lab/preguntas-html /lab/preguntas-css o /auth/password - /auth/status</p>
            <a href="/users/logout" class="button">Cerrar Sesión</a>
        <% } else { %>
            <h1>Bienvenido al Lab 14</h1>
            <p>Inicia sesión para acceder a todas las funciones</p>
            <a href="/users/login" class="button">Ir al Login</a>
        <% } %>
    </main>

