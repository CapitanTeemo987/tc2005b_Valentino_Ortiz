<%- include('includes/head.ejs') %>

<main class="max-w-4xl mx-auto p-6">
    <h1 class="text-2xl font-bold text-[#703d56] mb-6">Registro de Contraseñas</h1>
    
    <form action="/auth/password" method="POST" class="bg-white p-6 rounded shadow-md mb-8">
        <label class="block mb-2">Ingresa nueva contraseña:</label>
        <input type="password" name="pass1" class="border p-2 w-full mb-4">
        <button class="bg-[#703d56] text-white px-4 py-2 rounded">Guardar</button>
    </form>

    <h2 class="text-xl font-bold mb-4">Historial de registros:</h2>
    <ul>
        <% if (lista.length > 0) { %>
            <% for (let p of lista) { %>
                <li class="border-b py-2">Contraseña recibida: <%= p %></li>
            <% } %>
        <% } else { %>
            <p>No hay registros todavía.</p>
        <% } %>
    </ul>
</main>

<%- include('includes/footer.ejs') %>