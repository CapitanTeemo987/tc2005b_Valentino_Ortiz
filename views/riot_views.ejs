<%- include('includes/head.ejs') %>

<section class="max-w-4xl mx-auto p-6 bg-white rounded-lg shadow-md mt-10">
    <h2 class="text-2xl font-bold text-[#703d56] mb-6 text-center">Perfil de Invocador</h2>
    
    <% if (data) { %>
        <div class="flex items-center space-x-6 p-6 bg-gray-50 rounded-xl border border-gray-200">
            <div class="relative">
                <img src="https://ddragon.leagueoflegends.com/cdn/13.24.1/img/profileicon/<%= data.profileIconId %>.png" 
                     alt="Icono" class="w-24 h-24 rounded-full border-4 border-[#be12b6]">
                <span class="absolute bottom-0 right-0 bg-black text-white text-xs px-2 py-1 rounded-full">
                    Nivel <%= data.summonerLevel %>
                </span>
            </div>

            <div>
                <h1 class="text-3xl font-black text-gray-800"><%= data.name %></h1>
                <p class="text-gray-500 font-mono">ID: <%= data.id || 'N/A' %></p>
                <p class="text-sm text-gray-400">Revisado el: <%= new Date().toLocaleDateString() %></p>
            </div>
        </div>

        <% if (matches && matches.length > 0) { %>
        <div class="mt-8">
            <h3 class="text-xl font-bold text-[#703d56] mb-4">Últimas 3 Partidas</h3>
            <% matches.forEach(match => { %>
                <% const participant = match.info.participants.find(p => p.puuid === data.puuid); %>
                <% if (participant) { %>
                <div class="bg-gray-50 p-4 rounded-lg border border-gray-200 mb-4 flex items-center space-x-4">
                    <img src="https://ddragon.leagueoflegends.com/cdn/13.24.1/img/champion/<%= participant.championName %>.png" 
                         alt="<%= participant.championName %>" class="w-16 h-16 rounded-full border-2 <%= participant.win ? 'border-green-500' : 'border-red-500' %>">
                    <div>
                        <p class="font-semibold"><%= participant.championName %></p>
                        <p class="<%= participant.win ? 'text-green-600' : 'text-red-600' %> font-bold"><%= participant.win ? 'Victoria' : 'Derrota' %></p>
                        <p class="text-sm text-gray-600">KDA: <%= participant.kills %>/<%= participant.deaths %>/<%= participant.assists %></p>
                        <p class="text-sm text-gray-600">Modo: <%= match.info.gameMode %> | Duración: <%= Math.floor(match.info.gameDuration / 60) %>:<%= (match.info.gameDuration % 60).toString().padStart(2, '0') %></p>
                    </div>
                </div>
                <% } %>
            <% }); %>
        </div>
        <% } %>

        <% if (wins + losses > 0) { %>
        <div class="mt-8">
            <h3 class="text-xl font-bold text-[#703d56] mb-4">Estadísticas de Partidas Recientes</h3>
            <div class="bg-gray-50 p-6 rounded-xl border border-gray-200">
                <canvas id="winLossChart" width="400" height="200"></canvas>
            </div>
        </div>
        <% } %>
    <% } else { %>
        <div class="bg-gray-50 p-6 rounded-xl border border-gray-200">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Buscar Invocador</h3>
            <form action="/riot/perfil" method="POST" class="space-y-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div>
                    <label for="username" class="block text-sm font-medium text-gray-700">Nombre de Usuario (gameName#tagLine)</label>
                    <input type="text" id="username" name="username" required 
                           placeholder="Ejemplo: valentinof31#LAN" 
                           class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-[#be12b6] focus:border-[#be12b6]">
                </div>
                <button type="submit" class="bg-[#703d56] text-white px-6 py-2 rounded-lg hover:bg-[#be12b6] transition">
                    Buscar
                </button>
            </form>
            <% if (error) { %>
                <div class="mt-4 bg-red-100 text-red-700 p-4 rounded-lg">
                    <%= error %>
                </div>
            <% } %>
        </div>
    <% } %>

    <div class="mt-8 text-center">
        <a href="/" class="bg-[#703d56] text-white px-6 py-2 rounded-lg hover:bg-[#be12b6] transition">Regresar</a>
    </div>
</section>

<script>
<% if (wins + losses > 0) { %>
const ctx = document.getElementById('winLossChart').getContext('2d');
const winLossChart = new Chart(ctx, {
    type: 'pie',
    data: {
        labels: ['Victorias', 'Derrotas'],
        datasets: [{
            data: [<%= wins %>, <%= losses %>],
            backgroundColor: [
                'rgba(34, 197, 94, 0.8)', // green for wins
                'rgba(239, 68, 68, 0.8)'  // red for losses
            ],
            borderColor: [
                'rgba(34, 197, 94, 1)',
                'rgba(239, 68, 68, 1)'
            ],
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: {
                position: 'top',
            },
            title: {
                display: true,
                text: 'Victorias vs Derrotas en las últimas <%= wins + losses %> partidas'
            }
        }
    }
});
<% } %>
</script>

<%- include('includes/footer.ejs') %>